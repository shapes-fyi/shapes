{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapes.fyi/schema/v0.1.0/node-id.json",
  "title": "NodeId",
  "description": "Opaque node identifier. May be a non-negative integer or a non-empty string.",
  "oneOf": [
    {
      "type": "integer",
      "minimum": 0,
      "description": "Numeric node identifier."
    },
    {
      "type": "string",
      "minLength": 1,
      "description": "String node identifier."
    }
  ]
}
