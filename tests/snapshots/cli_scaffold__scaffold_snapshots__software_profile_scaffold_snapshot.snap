---
source: tests/cli_scaffold.rs
expression: yaml
---
# Generated by `shapes create profile`. A Profile declares which intent fields
# and kinds are required for shapes and constraints in this project. Profiles are
# OPTIONAL — shapes and constraints work without one. Attach a profile by passing
# `--profile <id>` to `shapes create`, which will pre-populate required fields and
# validate kinds. The fields below are seeded from the active template; edit them
# to match this project's needs and run `shapes validate` when ready.

id: 1
name: "Strict"
description: |
    TODO: paragraph describing what this Profile governs and why
status: proposed
intent:
  kind: governance
  summary: "TODO: one-line summary of what this profile governs"
  source: "human"

fields:
  shape:
    intent:
      fields:
        - name: "goals"
          description: "What this shape must achieve — concrete, observable outcomes"
          required: true
        - name: "rationale"
          description: "Why this approach was chosen over alternatives"
          required: true
        - name: "non_goals"
          description: "What is explicitly out of scope"
          required: false
        - name: "requirements"
          description: "Specific functional requirements this shape must meet"
          required: false
      kinds:
        - name: "system"
          description: "Top-level system — the project as a whole"
        - name: "service"
          description: "A long-running service or daemon"
        - name: "feature"
          description: "A user-facing capability"
        - name: "module"
          description: "A cohesive code module"
        - name: "interface"
          description: "An API, contract, or boundary"
        - name: "data-flow"
          description: "How data moves through the system"
        - name: "pattern"
          description: "A reusable design pattern"
  constraint:
    intent:
      fields:
        - name: "rationale"
          description: "Why this rule exists — the incident or decision that created it"
          required: true
        - name: "impact_if_violated"
          description: "What breaks if this rule is violated, and how badly"
          required: false
        - name: "exceptions"
          description: "Known cases where this rule does not apply"
          required: false
        - name: "verification_method"
          description: "How compliance is checked (test, review, lint, audit)"
          required: false
      kinds:
        - name: "invariant"
          description: "Must always hold — violating it is a bug"
        - name: "requirement"
          description: "Functional requirement the system must meet"
        - name: "boundary"
          description: "Hard architectural boundary"
        - name: "guideline"
          description: "Recommended practice; deviations need justification"
        - name: "limit"
          description: "A quantitative cap (rate, size, count, latency)"
        - name: "policy"
          description: "Organizational or compliance rule"

lifecycle:
  gates:
    - from: proposed
      to: promoted
      preconditions:
        - All required intent fields populated
    - from: promoted
      to: canonical
      preconditions:
        - Realization bindings present

amendment_rules:
  application: merge
